# Motorola Moto G7 Play / Moto G7 Optimo (channel)
DEVICE="motorola-channel"
DEVICE_PACKAGE="device-motorola-channel"
KERNEL_PACKAGE="linux-motorola-channel"
KERNEL_CHOICE="downstream"
FIRMWARE_PACKAGES="firmware-motorola-channel"
ARCH="aarch64"
CHANNEL="edge"
PMAPORTS_REF="main"
PMBOOTSTRAP_REF=""
USER_NAME="user"
LOCALE="en_US.UTF-8"
TIMEZONE="GMT"
BOOT_SIZE="512"
EXTRA_SPACE="0"
CCACHE_SIZE="2G"
EXPORT_ODIN="false"
KCONFIG_CHECK="false"
