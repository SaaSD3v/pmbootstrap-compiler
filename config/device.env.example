# Copy this file to config/device.env on a device/<codename> branch.
# Values are shell variables consumed by scripts/build-pmos.sh.

DEVICE="vendor-codename"
DEVICE_PACKAGE="device-vendor-codename"
KERNEL_PACKAGE="linux-postmarketos-example"
KERNEL_CHOICE="mainline"
FIRMWARE_PACKAGES=""
ARCH="aarch64"
CHANNEL="edge"

# Follow current pmaports by default. Override from workflow_dispatch when needed.
PMAPORTS_REF="main"
# Leave empty to use the default branch of the pmbootstrap repository.
PMBOOTSTRAP_REF=""

USER_NAME="user"
LOCALE="en_US.UTF-8"
TIMEZONE="GMT"
BOOT_SIZE="512"
EXTRA_SPACE="0"
CCACHE_SIZE="2G"

# true/false. Samsung devices commonly benefit from the Odin export.
EXPORT_ODIN="false"

# Run pmbootstrap kconfig check before the build.
KCONFIG_CHECK="true"
